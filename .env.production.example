# =================================================================
# GPSWOX Enterprise Production Environment Variables
# =================================================================

# Server & Runtime
NODE_ENV=production
PORT=3001

# JWT Authentication Secret (Change to your own 256-bit key)
JWT_SECRET=d94e24ebff8fa7c222ff4ae42b5887ce6a32d1891ce5c9c9b4566ef717462002

# PostgreSQL Database Configuration
# You can provide a complete connection string (e.g. from Railway / Render / Supabase):
# DATABASE_URL=postgres://postgres:password@postgres:5432/gpswox_fleet

# Or configure individual credentials:
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=gpswox_secure_pwd_2026
PGDATABASE=gpswox_fleet
PG_POOL_MAX=30

# CORS Whitelist (Comma-separated URLs or * to allow all)
ALLOWED_ORIGINS=*
